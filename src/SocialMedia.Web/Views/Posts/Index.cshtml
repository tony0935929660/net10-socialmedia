@model IReadOnlyList<SocialMedia.Shared.ViewModels.Posts.PostListItemViewModel>
@{
    ViewData["Title"] = "發文動態牆";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">發文動態牆</h1>
        <p class="text-muted mb-0">依發佈時間由新到舊排序</p>
    </div>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <a class="btn btn-primary" asp-action="Create">新增發文</a>
    }
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

@if (Model.Count == 0)
{
    <div class="alert alert-info">目前尚無發文。</div>
}
else
{
    <div class="row g-4">
        @foreach (var post in Model)
        {
            <div class="col-12">
                <article class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div>
                                <h2 class="h5 mb-1">
                                    <a class="text-decoration-none" asp-controller="Profile" asp-action="Index" asp-route-userId="@post.UserId">@post.UserName</a>
                                </h2>
                                <div class="text-muted small">@post.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                            </div>
                            <a class="text-muted small text-decoration-none" asp-action="Details" asp-route-id="@post.PostId">留言數：@post.CommentCount</a>
                        </div>

                        <p class="mt-3 mb-3">@post.Content</p>

                        <a class="btn btn-link p-0 text-decoration-none" asp-action="Details" asp-route-id="@post.PostId">查看詳細</a>

                        @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                        {
                            <div class="mb-3">
                                <img src="@Url.Content("~/" + post.ImagePath)" alt="Post image" class="img-fluid rounded" />
                            </div>
                        }

                        @if (post.CanEdit)
                        {
                            <div class="d-flex flex-wrap gap-2">
                                <a class="btn btn-outline-secondary btn-sm" asp-action="Edit" asp-route-id="@post.PostId">編輯</a>
                                <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@post.PostId">刪除</a>
                            </div>
                        }
                    </div>
                </article>
            </div>
        }
    </div>
}
