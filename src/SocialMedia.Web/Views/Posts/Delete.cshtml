@model SocialMedia.Shared.ViewModels.Posts.PostDeleteViewModel
@{
    ViewData["Title"] = "刪除發文";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-danger">
            <div class="card-body p-4">
                <h1 class="h3 text-danger mb-3">確認刪除發文</h1>
                <p class="text-muted">刪除後，該發文的所有留言也會一併移除。</p>

                <dl class="row mb-4">
                    <dt class="col-sm-3">作者</dt>
                    <dd class="col-sm-9">@Model.UserName</dd>

                    <dt class="col-sm-3">時間</dt>
                    <dd class="col-sm-9">@Model.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</dd>

                    <dt class="col-sm-3">留言數</dt>
                    <dd class="col-sm-9">@Model.CommentCount</dd>

                    <dt class="col-sm-3">內容</dt>
                    <dd class="col-sm-9">@Model.Content</dd>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                {
                    <div class="mb-4">
                        <img src="@Url.Content("~/" + Model.ImagePath)" alt="Post image" class="img-fluid rounded" />
                    </div>
                }

                <form asp-action="DeleteConfirmed" method="post">
                    <input type="hidden" name="postId" value="@Model.PostId" />
                    <button type="submit" class="btn btn-danger">確認刪除</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">取消</a>
                </form>
            </div>
        </div>
    </div>
</div>
