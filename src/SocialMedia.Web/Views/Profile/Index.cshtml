@model SocialMedia.Shared.ViewModels.Profile.ProfileViewModel
@{
    ViewData["Title"] = "Profile";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="row g-4 align-items-start">
                    <div class="col-12 col-md-4">
                        @if (!string.IsNullOrWhiteSpace(Model.User.CoverImagePath))
                        {
                            <img src="@Url.Content("~/" + Model.User.CoverImagePath)" alt="Cover image" class="img-fluid rounded" />
                        }
                        else
                        {
                            <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted" style="min-height: 200px;">
                                No cover image
                            </div>
                        }
                    </div>
                    <div class="col-12 col-md-8">
                        <h1 class="h3 mb-2">@Model.User.UserName</h1>
                        <div class="text-muted mb-2">@Model.User.Email</div>
                        @if (!string.IsNullOrWhiteSpace(Model.User.Biography))
                        {
                            <p class="mb-0">@Model.User.Biography</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <section class="card shadow-sm">
            <div class="card-body p-4">
                <h2 class="h4 mb-3">發文</h2>
                @if (Model.Posts.Count == 0)
                {
                    <div class="alert alert-info">目前沒有發文。</div>
                }
                else
                {
                    <div class="row g-4">
                        @foreach (var post in Model.Posts)
                        {
                            <div class="col-12">
                                <article class="card">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between align-items-start gap-3">
                                            <div class="text-muted small">@post.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</div>
                                            <div class="text-muted small">留言數：@post.CommentCount</div>
                                        </div>
                                        <p class="mt-3 mb-3">@post.Content</p>
                                        @if (!string.IsNullOrWhiteSpace(post.ImagePath))
                                        {
                                            <img src="@Url.Content("~/" + post.ImagePath)" alt="Post image" class="img-fluid rounded mb-3" />
                                        }
                                        <a class="btn btn-outline-primary btn-sm" asp-controller="Posts" asp-action="Details" asp-route-id="@post.PostId">查看詳細</a>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                }
            </div>
        </section>
    </div>
</div>
